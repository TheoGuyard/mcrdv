{
  "experiment": {
    "name": "run"
  },
  "problem": {
    "path": "data/iridium33.csv",
    "pos_chasers": "centroid",
    "num_chasers": 15,
    "max_time": 31536000.0,
    "max_load": 10
  },
  "solver": {
    "type": "mcrdv",
    "args": {
      "transfer": {
        "type": "qlaw",
        "args": {
          "thrust": 3e-3,
          "factor": 1.5,
          "num_samples": 512,
          "num_hints": 32,
          "cost_factor_time": 1.0,
          "cost_factor_fuel": 0.0
        }
      },
      "schedule": {
        "type": "dp",
        "args": {
          "allow_waiting": true,
          "grid_size": 32,
          "use_hints": true,
          "use_cache": true
        }
      },
      "sequence": {
        "type": "hgs",
        "args": {
          "preset": 5,
          "seed": 0,
          "max_time": 60.0
        }
      }
    }
  }
}